{
  "name": "guildthing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@guildthing/web",
    "build": "turbo run build",
    "start": "pnpm --filter @guildthing/web start",
    "preview": "turbo run build && pnpm --filter @guildthing/web start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "db:generate": "pnpm --filter @guildthing/db db:generate",
    "db:migrate": "pnpm --filter @guildthing/db db:migrate",
    "db:push": "pnpm --filter @guildthing/db db:push",
    "db:studio": "pnpm --filter @guildthing/db db:studio",
    "wowhead:sync": "pnpm --filter @guildthing/wowhead-data sync",
    "resolve-spell-ids": "pnpm --filter @guildthing/wowhead-data resolve-spell-ids",
    "addon:catalog": "pnpm --filter @guildthing/addon catalog",
    "addon:package": "pnpm --filter @guildthing/addon package"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.28.2"
}
