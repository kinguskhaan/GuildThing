{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["SKIP_ENV_VALIDATION", "DATABASE_URL", "BETTER_AUTH_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "typecheck": {},
    "check": {
      "dependsOn": ["^build"]
    }
  }
}
