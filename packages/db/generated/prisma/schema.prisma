// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id            String    @id
  name          String //@db.Text
  // Display name shown in-app (Members list, character ownership) instead
  // of the Discord account name, if the user has set one.
  nickname      String? //@db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String? //@db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  createdGuilds            Guild[]
  lastExportedGuilds       Guild[]               @relation("GuildLastExportedBy")
  lastRosterImportedGuilds Guild[]               @relation("GuildLastRosterImportedBy")
  guildCharacters          GuildCharacter[]
  addedGuildCreators       AllowedGuildCreator[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// Single row (id is always the literal "singleton") holding instance-wide
// settings that aren't tied to any one Guild — currently just who's
// allowed to create a guild page at all. Only the instance owner (see
// env.GUILD_CREATOR_EMAIL — always allowed, can't be locked out) can
// change this.
model InstanceSettings {
  id String @id @default("singleton")

  // "owner" — only GUILD_CREATOR_EMAIL (the default, matches the old
  //   hardcoded behavior).
  // "allowlist" — GUILD_CREATOR_EMAIL plus anyone in AllowedGuildCreator.
  // "public" — any signed-in user.
  guildCreationMode String @default("owner")
}

// One email allowed to create a guild page when InstanceSettings is in
// "allowlist" mode — the instance owner's "let specific friends in"
// list. Keyed by email (not userId) so the owner can add someone before
// they've ever signed in.
model AllowedGuildCreator {
  id        String   @id @default(cuid())
  email     String   @unique
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())
}

model Guild {
  id                    String                      @id @default(cuid())
  name                  String
  discordGuildId        String                      @unique
  createdById           String
  createdBy             User                        @relation(fields: [createdById], references: [id])
  characters            GuildCharacter[]
  requiredRoles         GuildRequiredRole[]
  adminRoles            GuildAdminRole[]
  rosterMembers         GuildRosterMember[]
  roleRules             GuildRoleRule[]
  claimConflicts        GuildRosterClaimConflict[]
  pendingRosterMatches  GuildPendingRosterMatch[]
  memberActivity        GuildMemberActivity[]
  inactivityTargetRoles GuildInactivityTargetRole[]
  pugMembers            GuildPugMember[]
  events                Event[]
  eventChannelPresets   EventChannelPreset[]
  createdAt             DateTime                    @default(now())

  // "addon" (default) — the roster comes from pasting the GuildThing
  // Roster addon's export; onboarding only matches/claims characters that
  // already exist there, and an unmatched name gets queued to retry once
  // the roster catches up (see GuildPendingRosterMatch).
  // "onboarding" — for a play group with no in-game guild to scan a roster
  // from. There's no addon import; onboarding itself creates the roster
  // row the moment someone claims a name, asking for their class since
  // nothing else can supply it. rank is fixed to "Member" and level to 1
  // for every row created this way — neither means anything without a
  // real guild hierarchy backing them.
  rosterSource String @default("addon")

  // Whether onboarding even asks "guild member or PUG?" at all. Off by
  // default is wrong for existing guilds mid-use, so this defaults to on;
  // a guild that doesn't want PUGs can turn it off and onboarding skips
  // straight to the guild-member flow for everyone.
  pugEnabled Boolean @default(true)
  // Discord role given to someone who says they're here for a PUG, not as
  // a guild member — set by an admin, bot assigns it directly with no rule
  // evaluation (see GuildRoleRule) when the bot's onboarding DM gets that
  // answer. Irrelevant while pugEnabled is false.
  pugRoleId  String?

  // Who last generated the addon export string, and when — shown on the
  // guild page so admins can tell if the pasted-in-game data is stale.
  lastExportedAt   DateTime?
  lastExportedById String?
  lastExportedBy   User?     @relation("GuildLastExportedBy", fields: [lastExportedById], references: [id])

  // Who last pasted in a GuildThing Roster addon export, and when — same
  // staleness-flagging idea as lastExportedAt, for the separate roster
  // (name/rank/level/class, not recipes) import.
  lastRosterImportedAt   DateTime?
  lastRosterImportedById String?
  lastRosterImportedBy   User?     @relation("GuildLastRosterImportedBy", fields: [lastRosterImportedById], references: [id])

  // Discord channel (visible to officers + the bot only, by convention —
  // not enforced here) the bot posts admin notices to, e.g. a roster-name
  // claim conflict. Optional: if unset, the bot just skips posting.
  adminNotifyChannelId String?

  // Public channel (e.g. #welcome) the bot keeps a standing "Start
  // Onboarding" button message in, as an alternative to the /onboarding
  // slash command — lets anyone (re-)trigger the DM flow with one click.
  // onboardingMessageId is the bot's own bookkeeping (which message is
  // "the" button, so it can be reused instead of reposted every check) —
  // not meant to be read or set from the website.
  onboardingChannelId   String?
  onboardingMessageId   String?
  // Admin-customizable button message text — null means use the bot's
  // built-in default (see buildButtonMessage in onboardingButton.ts).
  onboardingMessageText String?

  // Set by the "Sync now" button on the site — the bot's next check
  // (within ~15s, see checkForceSyncRequests in the bot) runs a full
  // roster/role/channel-grant resync immediately instead of waiting for
  // the daily automatic one, then clears this back to null.
  forceSyncRequestedAt DateTime?

  // Inactivity filter — ported from a proven pattern in another Discord
  // bot (role-swap, not kick, so it's reversible). Members holding ANY of
  // inactivityTargetRoles (see below — a list, not a single role: e.g.
  // "PUG" OR "Trial Raider" can both be tracked) who haven't sent a
  // message in inactivityDays get their other roles saved and swapped for
  // inactivityRoleId; they can restore themselves with /reactivate.
  // Deliberately admin-configurable rather than hardcoded to "PUG" — same
  // "admin builds their own rule" philosophy as GuildRoleRule.
  inactivityFilterEnabled Boolean @default(false)
  inactivityDays          Int?
  inactivityRoleId        String?

  @@index([discordGuildId])
}

// One role that counts a member as trackable by the inactivity filter —
// OR'd together (any one of these roles is enough), kept as its own table
// rather than a scalar list for the same reason GuildRoleRuleGrantedRole
// is: SQLite/Prisma has no native array column.
model GuildInactivityTargetRole {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String

  @@unique([guildId, discordRoleId])
}

// A snapshot of the guild's in-game roster (name/rank/level/class/notes),
// pasted in from the GuildThing Roster addon's /gtr export by an admin.
// Deliberately NOT tied to userId like GuildCharacter is — a roster scan
// covers every member at once, reported by whoever ran the addon, not
// self-reported per account. Re-imports upsert by (guildId, name) rather
// than delete+recreate, since a full replace would wipe claimedBy* below
// on every re-import.
model GuildRosterMember {
  id          String  @id @default(cuid())
  guildId     String
  guild       Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  rank        String
  level       Int
  class       String?
  note        String?
  officerNote String?

  // Set on first onboarding match: which Discord account claimed this
  // character. A later claim by a DIFFERENT Discord account still sets
  // their nickname from this name (cosmetic), but grants no roles for it
  // and logs a GuildRosterClaimConflict instead of overwriting the claim.
  claimedByDiscordUserId String?
  claimedByDiscordTag    String?

  claimConflicts GuildRosterClaimConflict[]

  @@unique([guildId, name])
}

// Logged when a Discord account other than the current claimedBy* tries to
// claim an already-claimed roster name during onboarding — surfaced on the
// roster page and (if configured) posted to Guild.adminNotifyChannelId.
model GuildRosterClaimConflict {
  id                    String            @id @default(cuid())
  guildId               String
  guild                 Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rosterMemberId        String
  rosterMember          GuildRosterMember @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)
  attemptedByDiscordId  String
  attemptedByDiscordTag String
  createdAt             DateTime          @default(now())
}

// Someone completed onboarding claiming guild membership, but none of the
// names they gave matched the roster at the time — most likely because the
// roster just hasn't been (re-)imported since they joined yet, not a
// mistake on their part. Held here so the daily role-sync job can retry the
// match automatically once the roster catches up, instead of the person
// being permanently stuck with no roles until someone notices and tells
// them to re-run /onboarding. Expires ~42h after creation if still
// unmatched (see PENDING_MATCH_RETENTION_MS in the bot).
model GuildPendingRosterMatch {
  id                    String   @id @default(cuid())
  guildId               String
  guild                 Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId         String
  discordUserTag        String
  names                 String // JSON array of the names they typed, main first
  includeAltsInNickname Boolean
  createdAt             DateTime @default(now())

  @@unique([guildId, discordUserId])
}

// Marks a Discord account as having completed onboarding claiming "PUG",
// independent of whether a PUG role is even configured (Guild.pugRoleId
// can be unset, or role assignment can silently fail on permissions) —
// this is the authoritative record of "chose PUG", used to exclude PUGs
// from the "hasn't claimed a character" admin view without relying on
// role state. Removed if the same account later re-onboards as a guild
// member instead.
model GuildPugMember {
  id             String   @id @default(cuid())
  guildId        String
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId  String
  discordUserTag String
  markedAt       DateTime @default(now())

  @@unique([guildId, discordUserId])
}

// Last time each Discord member was seen sending a message in the guild's
// server, plus their join time — feeds the inactivity filter above
// (Guild.inactivityFilterEnabled etc). Updated at most every 12h per
// message (see ACTIVITY_UPDATE_THROTTLE_MS in the bot) to avoid writing on
// every single message. previousRoleIds/markedInactiveAt are set when the
// daily filter swaps someone to the inactive role, so /reactivate can
// restore exactly what they had.
model GuildMemberActivity {
  id               String    @id @default(cuid())
  guildId          String
  guild            Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId    String
  discordUserTag   String
  lastActiveAt     DateTime
  joinedAt         DateTime
  previousRoleIds  String? // JSON array, snapshotted right before being marked inactive
  markedInactiveAt DateTime?

  @@unique([guildId, discordUserId])
}

// A Discord-onboarding role grant rule: fires — granting every one of its
// grantedRoles — only when every one of its conditions is satisfied.
// Admin-built on the site — deliberately not fixed "rank role" / "level
// role" special cases, so any combination of rank/level/class conditions
// can gate any set of roles (e.g. rank "Trial Raider" granting both a
// generic "Guildie" role and a "Trial Raider" role from the same rule).
model GuildRoleRule {
  id              String                        @id @default(cuid())
  guildId         String
  guild           Guild                         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  label           String?
  grantedRoles    GuildRoleRuleGrantedRole[]
  grantedChannels GuildRoleRuleGrantedChannel[]
  conditions      GuildRoleRuleCondition[]
}

// One Discord role a GuildRoleRule grants when it fires. A rule can grant
// several — kept as its own table rather than a scalar list since SQLite/
// Prisma has no native array column, same reasoning as conditions below.
model GuildRoleRuleGrantedRole {
  id            String        @id @default(cuid())
  ruleId        String
  rule          GuildRoleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  discordRoleId String
}

// Direct per-member channel access a GuildRoleRule grants when it fires —
// an alternative/addition to grantedRoles for when access should be scoped
// to one specific channel rather than going through a role. Applied as a
// per-member permission overwrite (ViewChannel, plus Connect for voice),
// not a role, so it works even for a channel an admin doesn't want tied to
// any existing role.
model GuildRoleRuleGrantedChannel {
  id               String        @id @default(cuid())
  ruleId           String
  rule             GuildRoleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  discordChannelId String
  channelType      String // "text" | "voice" — determines which permissions get granted
}

// One AND'd condition within a GuildRoleRule. Satisfied if ANY of the
// person's matched characters (main or alt, from the bot's onboarding DM)
// meets it — different conditions in the same rule can each be satisfied
// by a different character (e.g. rank condition met by the main, level
// condition met by an alt).
model GuildRoleRuleCondition {
  id        String        @id @default(cuid())
  ruleId    String
  rule      GuildRoleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  field     String // "rank" | "level" | "class"
  operator  String // "equals" (rank/class) | "between" (level)
  textValue String? // used when operator == "equals"
  minNumber Int? // used when operator == "between"
  maxNumber Int? // used when operator == "between"
}

// A custom event signup — e.g. a 5-man dungeon group — created either via
// the bot's /event create command or the site's event form. Posted/kept in
// sync as a single Discord message the bot edits in place (discordMessageId
// is null until the bot's poll picks it up and posts it, which is how a
// web-created event reaches Discord — same "web writes the DB + a flag, the
// bot's periodic tick notices and acts" pattern as forceSyncRequestedAt).
// Signing up, voting, leaving, and cancelling all happen through the
// Discord message's own components — the site only creates/lists/cancels,
// it doesn't mirror the interactive parts.
// A channel-specific default role composition (e.g. the "Wailing Caverns"
// channel always wants Tank:1, Healer:1, DPS:3) — pre-fills the "Roles"
// field when /guildthing event is run in that channel, instead of retyping
// the same composition every time. Stored in the same "Name:Count:Emoji,
// ..." format the create modal's Roles field already parses (see
// parseRoleSlots in apps/bot/src/events.ts), so it can be dropped straight
// into that field's default value with no extra parsing/formatting.
// Also doubles as per-channel event-button config — buttonEnabled is
// independent of whether a roles preset is set (a channel can have a
// standing "Create new event" button with no preset, or a preset with no
// button), same "each part optional, use what you need" spirit as the rest
// of this feature.
model EventChannelPreset {
  id               String  @id @default(cuid())
  guildId          String
  guild            Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordChannelId String
  roles            String?

  // Whether the bot keeps a standing "Create new event" button message at
  // the bottom of this channel — same idea as Guild.onboardingChannelId's
  // button, for people who'd rather click than type /guildthing event.
  buttonEnabled   Boolean @default(false)
  buttonMessageId String?

  @@unique([guildId, discordChannelId])
}

model Event {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  title                String
  imageUrl             String?
  // "yyyy-mm-dd" — shown as "Date: {date}" on the embed. Defaults to
  // today's date in both the bot modal and the web form (not enforced
  // here), so it's rarely actually null in practice.
  date                 String?
  // Free-text blurb shown under the title on the embed. Not on the bot's
  // create modal (already at Discord's 5-text-input cap) — set via the web
  // form at creation, or the bot's Edit modal afterward.
  description          String?
  // Whether the "+ Add time option" button shows at all — off lets a
  // creator post one or more FIXED times (e.g. "just tonight at 20:00, no
  // discussion") without randoms tacking on more alternatives to vote
  // on. Toggled via a button on the posted event (no room for a checkbox
  // in the create modal — Discord modals don't support that component
  // type at all, not just a field-count limit). Voting on whatever options
  // already exist still works regardless of this.
  allowTimeSuggestions Boolean @default(true)

  createdByDiscordUserId String
  createdByDiscordTag    String

  discordChannelId String
  // Each event gets its own thread (named after the title) so signing up
  // doesn't clutter the parent channel — null until the bot's poll (or
  // immediate post, for bot-created events) creates it. Deleted outright
  // when the event is cancelled, for a clean "it's just gone" cancel.
  discordThreadId  String?
  // The embed message posted inside that thread — null until the thread
  // exists.
  discordMessageId String?

  // "open" | "locked" | "cancelled"
  status             String  @default("open")
  // Set once locked (auto after 30min-since-createdAt or every role slot
  // full, whichever first — see runEventAutoLock) to whichever
  // EventTimeOption had the most votes.
  lockedTimeOptionId String?

  // Set by web-side create/cancel so the bot's poll tick knows to
  // (re)render the Discord message without waiting on any other signal —
  // cleared once the bot's synced it.
  pendingWebUpdate Boolean @default(false)

  createdAt DateTime @default(now())

  timeOptions EventTimeOption[]
  roleSlots   EventRoleSlot[]
  signups     EventSignup[]
  votes       EventTimeVote[]

  @@index([guildId])
}

// One proposed time slot people can vote for. Free-text label (e.g.
// "19:00–21:00") rather than structured start/end — nothing here parses or
// compares times, it's purely a votable option.
model EventTimeOption {
  id      String          @id @default(cuid())
  eventId String
  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label   String
  votes   EventTimeVote[]
}

// One person's vote in one event — a person has exactly one vote per event
// (moving it between options is "changing your vote", not adding another),
// hence the unique on (eventId, discordUserId) rather than per-option.
model EventTimeVote {
  id            String          @id @default(cuid())
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeOptionId  String
  timeOption    EventTimeOption @relation(fields: [timeOptionId], references: [id], onDelete: Cascade)
  discordUserId String
  votedAt       DateTime        @default(now())

  @@unique([eventId, discordUserId])
}

// A role bucket needed for the event (e.g. "Tank" x1, "DPS" x3) — free-text
// name rather than a fixed tank/healer/dps enum, so this isn't locked to
// WoW's trinity if it's ever used for something else.
model EventRoleSlot {
  id       String        @id @default(cuid())
  eventId  String
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleName String
  capacity Int
  // Unicode emoji ("🛡️") or a Discord custom emoji in its raw <:name:id>/
  // <a:name:id> form — whoever creates the event picks it, shown next to
  // the role name on the embed. Null falls back to no icon at all.
  emoji    String?
  signups  EventSignup[]
}

// One person signed up for one role slot in one event — the unique on
// (eventId, discordUserId) is what makes "sign up for a different role"
// a move rather than a second entry, same idea as EventTimeVote.
// characterName/class are auto-filled from the account's claimed
// GuildRosterMember when one exists, left null otherwise — nothing here
// re-asks for data the roster already has.
model EventSignup {
  id             String         @id @default(cuid())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Null for an "absence" entry (see status below) — someone marking
  // themselves absent isn't claiming any role, so there's nothing to point
  // this at.
  roleSlotId     String?
  roleSlot       EventRoleSlot? @relation(fields: [roleSlotId], references: [id], onDelete: Cascade)
  discordUserId  String
  discordUserTag String
  characterName  String?
  class          String?
  // "confirmed" | "tentative" | "absence" — confirmed/tentative toggle via
  // "Toggle tentative" and require a role slot; a tentative signup doesn't
  // count toward the slot's capacity (shown with a marker instead), so
  // someone unsure doesn't block someone who can commit. "absence" comes
  // from the "Absence" button instead, has no role slot, and is shown in
  // its own list on the embed rather than under any role.
  status         String         @default("confirmed")
  signedUpAt     DateTime       @default(now())

  @@unique([eventId, discordUserId])
}

model GuildRequiredRole {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String

  @@unique([guildId, discordRoleId])
}

// Discord role IDs that grant admin rights within the app for this guild
// (editing guild settings, viewing the raw recipe catalog) — separate from
// requiredRoles, which only grants ordinary view/import access.
model GuildAdminRole {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String

  @@unique([guildId, discordRoleId])
}

model GuildCharacter {
  id          String       @id @default(cuid())
  guildId     String
  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  realm       String
  // WoW class token (e.g. "WARRIOR") — sent by the addon's export, null for
  // characters added through the manual entry form (createCharacter), which
  // has no way to know it.
  class       String?
  importedAt  DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  professions Profession[]

  @@unique([guildId, userId, name, realm])
}

model Profession {
  id          String         @id @default(cuid())
  characterId String
  character   GuildCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  recipes     Recipe[]

  @@unique([characterId, name])
}

model Recipe {
  id           String     @id @default(cuid())
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  name         String
  itemId       Int?
  spellId      Int?

  @@index([professionId])
  @@index([name])
}

// Persists resolved Discord guild-member roles across server restarts.
// Discord's /users/@me/guilds/{id}/member endpoint rate-limits hard (order
// of minutes), and an in-memory-only cache gets wiped by every dev-server
// reload or prod deploy, which was enough on its own to trigger repeated
// 429s. roles is JSON-encoded (null when the user isn't a guild member).
model DiscordMemberRoleCache {
  id             String   @id @default(cuid())
  discordGuildId String
  userId         String
  roles          String?
  fetchedAt      DateTime @default(now())

  @@unique([discordGuildId, userId])
}

// Caches a Discord server's own name/icon (from /users/@me/guilds, keyed by
// whichever user's token we last used). Server-owned data, not per-viewer —
// safe to reuse for any user, so this is keyed by discordGuildId alone.
model DiscordGuildInfoCache {
  discordGuildId String   @id
  name           String
  icon           String?
  fetchedAt      DateTime @default(now())
}
