// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id            String    @id
  name          String //@db.Text
  // Display name shown in-app (Members list, character ownership) instead
  // of the Discord account name, if the user has set one.
  nickname      String? //@db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String? //@db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  createdGuilds           Guild[]
  lastExportedGuilds      Guild[]         @relation("GuildLastExportedBy")
  lastRosterImportedGuilds Guild[]        @relation("GuildLastRosterImportedBy")
  guildCharacters         GuildCharacter[]
  addedGuildCreators      AllowedGuildCreator[]
  createdApiKeys          GuildApiKey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// Single row (id is always the literal "singleton") holding instance-wide
// settings that aren't tied to any one Guild — currently just who's
// allowed to create a guild page at all. Only the instance owner (see
// env.GUILD_CREATOR_EMAIL — always allowed, can't be locked out) can
// change this.
model InstanceSettings {
  id String @id @default("singleton")

  // "owner" — only GUILD_CREATOR_EMAIL (the default, matches the old
  //   hardcoded behavior).
  // "allowlist" — GUILD_CREATOR_EMAIL plus anyone in AllowedGuildCreator.
  // "public" — any signed-in user.
  guildCreationMode String @default("owner")
}

// One email allowed to create a guild page when InstanceSettings is in
// "allowlist" mode — the instance owner's "let specific friends in"
// list. Keyed by email (not userId) so the owner can add someone before
// they've ever signed in.
model AllowedGuildCreator {
  id        String   @id @default(cuid())
  email     String   @unique
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())
}

model Guild {
  id             String   @id @default(cuid())
  name           String
  // URL-safe identifier derived from `name` at creation time (e.g. "My
  // Guild" -> "my-guild") — used in routes instead of `id` so links are
  // readable. Doesn't change if the guild is later renamed, so existing
  // links keep working.
  slug           String   @unique
  discordGuildId String   @unique
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  characters     GuildCharacter[]
  requiredRoles  GuildRequiredRole[]
  adminRoles     GuildAdminRole[]
  rosterMembers  GuildRosterMember[]
  roleRules      GuildRoleRule[]
  rolePriorities GuildRolePriority[]
  claimConflicts GuildRosterClaimConflict[]
  roleChangeEvents GuildRoleChangeEvent[]
  rankChangeEvents GuildRankChangeEvent[]
  pendingRosterMatches GuildPendingRosterMatch[]
  memberActivity GuildMemberActivity[]
  inactivityTargetRoles GuildInactivityTargetRole[]
  protectedRoles GuildProtectedRole[]
  pugMembers     GuildPugMember[]
  externalCharacters GuildExternalCharacter[]
  memberNicknames GuildMemberNickname[]
  events         Event[]
  eventChannelPresets EventChannelPreset[]
  apiKeys        GuildApiKey[]
  onboardingQuestions GuildOnboardingQuestion[]
  onboardingEdges     GuildOnboardingEdge[]
  onboardingAnswers   GuildOnboardingAnswer[]
  createdAt      DateTime @default(now())

  // "addon" (default) — the roster comes from pasting the GuildThing
  // Roster addon's export; onboarding only matches/claims characters that
  // already exist there, and an unmatched name gets queued to retry once
  // the roster catches up (see GuildPendingRosterMatch).
  // "onboarding" — for a play group with no in-game guild to scan a roster
  // from. There's no addon import; onboarding itself creates the roster
  // row the moment someone claims a name, asking for their class since
  // nothing else can supply it. rank is fixed to "Member" and level to 1
  // for every row created this way — neither means anything without a
  // real guild hierarchy backing them.
  rosterSource String @default("addon")

  // Whether onboarding even asks "guild member or PUG?" at all. Off by
  // default is wrong for existing guilds mid-use, so this defaults to on;
  // a guild that doesn't want PUGs can turn it off and onboarding skips
  // straight to the guild-member flow for everyone.
  pugEnabled Boolean @default(true)
  // Discord role given to someone who says they're here for a PUG, not as
  // a guild member — set by an admin, bot assigns it directly with no rule
  // evaluation (see GuildRoleRule) when the bot's onboarding DM gets that
  // answer. Irrelevant while pugEnabled is false.
  pugRoleId String?

  // Who last generated the addon export string, and when — shown on the
  // guild page so admins can tell if the pasted-in-game data is stale.
  lastExportedAt   DateTime?
  lastExportedById String?
  lastExportedBy   User?     @relation("GuildLastExportedBy", fields: [lastExportedById], references: [id])

  // Who last pasted in a GuildThing Roster addon export, and when — same
  // staleness-flagging idea as lastExportedAt, for the separate roster
  // (name/rank/level/class, not recipes) import.
  lastRosterImportedAt   DateTime?
  lastRosterImportedById String?
  lastRosterImportedBy   User?      @relation("GuildLastRosterImportedBy", fields: [lastRosterImportedById], references: [id])

  // Discord channel (visible to officers + the bot only, by convention —
  // not enforced here) the bot posts admin notices to, e.g. a roster-name
  // claim conflict. Optional: if unset, the bot just skips posting.
  adminNotifyChannelId String?

  // Public channel (e.g. #welcome) the bot keeps a standing "Start
  // Onboarding" button message in, as an alternative to the /onboarding
  // slash command — lets anyone (re-)trigger the DM flow with one click.
  // onboardingMessageId is the bot's own bookkeeping (which message is
  // "the" button, so it can be reused instead of reposted every check) —
  // not meant to be read or set from the website.
  onboardingChannelId String?
  onboardingMessageId String?
  // Admin-customizable button message text — null means use the bot's
  // built-in default (see buildButtonMessage in onboardingButton.ts).
  onboardingMessageText String?

  // Set by the "Sync now" button on the site — the bot's next check
  // (within ~15s, see checkForceSyncRequests in the bot) runs a full
  // roster/role/channel-grant resync immediately instead of waiting for
  // the daily automatic one, then clears this back to null.
  forceSyncRequestedAt DateTime?

  // Inactivity filter — ported from a proven pattern in another Discord
  // bot (role-swap, not kick, so it's reversible). Members holding ANY of
  // inactivityTargetRoles (see below — a list, not a single role: e.g.
  // "PUG" OR "Trial Raider" can both be tracked) who haven't sent a
  // message in inactivityDays get their other roles saved and swapped for
  // inactivityRoleId; they can restore themselves with /reactivate.
  // Deliberately admin-configurable rather than hardcoded to "PUG" — same
  // "admin builds their own rule" philosophy as GuildRoleRule.
  inactivityFilterEnabled Boolean @default(false)
  inactivityDays          Int?
  inactivityRoleId        String?

  // Battle.net Game Data API lookup config — lets onboarding tell apart a
  // typo'd/nickname-typed name (no such character), a real character in a
  // DIFFERENT guild, and a real character in THIS guild that just hasn't
  // been (re-)imported yet, instead of treating all three as "probably not
  // imported yet". All four null (the default) means the lookup is skipped
  // entirely — today's behavior, unchanged. See apps/bot/src/battlenetApi.ts.
  wowRegion          String? // e.g. "eu"
  wowRealmSlug       String? // e.g. "spineshatter"
  // The guild's actual in-game name, compared against a looked-up
  // character's current guild to tell "this guild" from "a different guild".
  wowGuildName       String?
  // Battle.net API namespace flavor, e.g. "classicann" for TBC Anniversary
  // realms. Kept configurable rather than hardcoded — this value has
  // already changed once (classic1x -> classicann) and may again, or may
  // need to differ for a guild on a different game version.
  wowNamespaceFlavor String? @default("classicann")

  @@index([discordGuildId])
}

// A secret bearer token that lets an external script (see apps/sync) push
// roster/character data to /api/v1/roster and /api/v1/characters without a
// Discord login — the key itself IS the auth, scoped to one guild, created
// only by an admin. The raw value is shown exactly once at creation time and
// never stored — only its hash, so a leaked database dump doesn't leak
// usable keys.
model GuildApiKey {
  id          String    @id @default(cuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // Admin-given label so multiple keys (e.g. one per officer's PC) are
  // distinguishable in the list.
  name        String
  keyHash     String    @unique
  // First few characters of the raw key (e.g. "gt_a1b2c3d4") — shown next to
  // the name so an admin can tell keys apart without ever seeing the secret
  // again.
  keyPrefix   String
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([guildId])
}

// One role that counts a member as trackable by the inactivity filter —
// OR'd together (any one of these roles is enough), kept as its own table
// rather than a scalar list for the same reason GuildRoleRuleGrantedRole
// is: SQLite/Prisma has no native array column.
model GuildInactivityTargetRole {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String

  @@unique([guildId, discordRoleId])
}

// A Discord role the bot must never add OR remove for anyone, even if it's
// also a grantedRole on a GuildRoleRule — for roles meant to stay entirely
// human-managed (e.g. an officer hand-picks who gets "TBC Raiders"), so a
// resync doesn't fight a manual assignment just because the member doesn't
// currently match whatever rule also happens to grant that role. See
// getManagedRoleIds in apps/bot/src/roleLogic.ts (and its duplicate in
// apps/bot/src/roleSync.ts), which subtracts this set before diffing.
model GuildProtectedRole {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String

  @@unique([guildId, discordRoleId])
}

// A snapshot of the guild's in-game roster (name/rank/level/class/notes),
// pasted in from the GuildThing Roster addon's /gtr export by an admin.
// Deliberately NOT tied to userId like GuildCharacter is — a roster scan
// covers every member at once, reported by whoever ran the addon, not
// self-reported per account. Re-imports upsert by (guildId, name) rather
// than delete+recreate, since a full replace would wipe claimedBy* below
// on every re-import.
model GuildRosterMember {
  id          String  @id @default(cuid())
  guildId     String
  guild       Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  rank        String
  // Bumped only when an import's incoming rank actually differs from what
  // was already stored (see applyRosterImport in wow-import.ts) — NOT a
  // plain @updatedAt, which would fire on every import regardless of
  // whether rank changed. Null until the first real rank transition after
  // this field existed, and stays null for a brand-new row (nothing to
  // have "changed" from yet). Used by the bot's role resync (roleSync.ts)
  // to tell whether a rank change is newer than a human's manual Discord
  // role edit — "the newest change wins" — see GuildRoleChangeEvent.
  rankChangedAt DateTime?
  level       Int
  class       String?
  note        String?
  officerNote String?

  // Set on first onboarding match: which Discord account claimed this
  // character. A later claim by a DIFFERENT Discord account still sets
  // their nickname from this name (cosmetic), but grants no roles for it
  // and logs a GuildRosterClaimConflict instead of overwriting the claim.
  claimedByDiscordUserId String?
  claimedByDiscordTag    String?
  // When the claim above was made — set alongside claimedByDiscordUserId
  // at every claim site (onboarding match, onboarding-created character,
  // admin "Claim a character"), never touched afterwards. Feeds the
  // unified audit log (guild.auditLog) as a "claim" entry, so admins can
  // see when someone first linked their Discord account to a character —
  // not just that they eventually did.
  claimedAt DateTime?

  // Created by an admin via "Claim a character" (guild.adminClaimCharacter)
  // instead of an addon roster scan — typically an out-of-guild alt that'll
  // never appear in an export. applyRosterImport's per-import cleanup
  // (delete anything not in the new export) skips these, otherwise the very
  // next addon import would silently wipe them right back out.
  manuallyAdded Boolean @default(false)

  claimConflicts GuildRosterClaimConflict[]

  @@unique([guildId, name])
}

// Logged when a Discord account other than the current claimedBy* tries to
// claim an already-claimed roster name during onboarding — surfaced on the
// roster page and (if configured) posted to Guild.adminNotifyChannelId.
model GuildRosterClaimConflict {
  id                    String            @id @default(cuid())
  guildId               String
  guild                 Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rosterMemberId        String
  rosterMember          GuildRosterMember @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)
  attemptedByDiscordId  String
  attemptedByDiscordTag String
  createdAt             DateTime          @default(now())
}

// Every role add/remove GuildThing has made on a member, from either
// source: the bot's own routine rule-based resync (source = "bot",
// executorId/executorTag null), or a human's manual Discord edit the
// resync detected and deliberately left alone rather than overwrite
// (source = "manual", executorId/executorTag set) — see roleSync.ts's and
// roleLogic.ts's "newest change wins" comparison against
// GuildRosterMember.rankChangedAt. A "manual" row is only ever created
// once per distinct detected edit — see hasLoggedManualChange in
// auditLog.ts — since the same still-unresolved human edit would otherwise
// get re-logged on every resync cycle for as long as it keeps winning.
// MAX(detectedAt) per discordUserId (manual rows only) is the "when did a
// human last touch this person's roles" side of that comparison on every
// later run; the merged feed (both sources) is also surfaced on the admin
// page. addedRoleIds/removedRoleIds are JSON-array-in-a-string, same
// convention as GuildPendingRosterMatch.names — a write-once, rarely-
// queried log row doesn't earn a normalized child table.
model GuildRoleChangeEvent {
  id               String   @id @default(cuid())
  guildId          String
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId    String
  discordUserTag   String
  source           String // "bot" | "manual"
  executorId       String?
  executorTag      String?
  addedRoleIds     String
  addedRoleNames   String
  removedRoleIds   String
  removedRoleNames String
  // For source = "manual": the audit-log entry's own timestamp (when the
  // human made the edit), what the newest-wins comparison actually uses.
  // For source = "bot": just the moment the resync applied the change.
  // Neither is row-creation time.
  detectedAt DateTime
  createdAt  DateTime @default(now())

  @@index([guildId, discordUserId])
}

// Logged whenever applyRosterImport (wow-import.ts) detects an actual rank
// transition for a roster row (same trigger that bumps
// GuildRosterMember.rankChangedAt) — the in-game half of the unified audit
// log shown on the roster page / admin panel / addon Audit Log tab, merged
// chronologically with GuildRoleChangeEvent (the Discord half). Keyed by
// characterName rather than FK'd to GuildRosterMember on purpose: a roster
// row can be deleted (member left, re-import drops them) without losing the
// history of what happened to that character while they were around.
model GuildRankChangeEvent {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characterName String
  oldRank       String?
  newRank       String
  detectedAt    DateTime @default(now())

  @@index([guildId, characterName])
}

// Someone completed onboarding claiming guild membership, but none of the
// names they gave matched the roster at the time — most likely because the
// roster just hasn't been (re-)imported since they joined yet, not a
// mistake on their part. Held here so the daily role-sync job can retry the
// match automatically once the roster catches up, instead of the person
// being permanently stuck with no roles until someone notices and tells
// them to re-run /onboarding. Expires ~42h after creation if still
// unmatched (see PENDING_MATCH_RETENTION_MS in the bot).
model GuildPendingRosterMatch {
  id                    String   @id @default(cuid())
  guildId               String
  guild                 Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId         String
  discordUserTag        String
  names                 String   // JSON array of the names they typed, main first
  includeAltsInNickname Boolean
  createdAt             DateTime @default(now())

  @@unique([guildId, discordUserId])
}

// Marks a Discord account as having completed onboarding claiming "PUG",
// independent of whether a PUG role is even configured (Guild.pugRoleId
// can be unset, or role assignment can silently fail on permissions) —
// this is the authoritative record of "chose PUG", used to exclude PUGs
// from the "hasn't claimed a character" admin view without relying on
// role state. Removed if the same account later re-onboards as a guild
// member instead.
model GuildPugMember {
  id             String   @id @default(cuid())
  guildId        String
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId  String
  discordUserTag String
  markedAt       DateTime @default(now())

  @@unique([guildId, discordUserId])
}

// Tracks each Discord member's assembled Discord nickname across onboarding
// runs, and an optional admin/self-set override. computedName is refreshed
// by matchRosterAndApply every time it runs (main + included alts, "/"-
// joined, main first) — what the nickname would be with no override.
// preferredNickname, when set, is what's actually used instead. Lets the
// site show both side by side and clear preferredNickname to revert to
// computedName with one click (see guild-member-nicknames.tsx).
model GuildMemberNickname {
  id                String   @id @default(cuid())
  guildId           String
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId     String
  discordUserTag    String
  computedName      String
  preferredNickname String?
  updatedAt         DateTime @updatedAt

  @@unique([guildId, discordUserId])
}

// A character someone typed during onboarding that the Battle.net lookup
// confirmed is real, but NOT a member of this guild (either in a different
// guild, or in none at all) — see Guild.wowRegion etc. and
// apps/bot/src/battlenetApi.ts. Kept separate from GuildRosterMember, which
// represents this guild's own roster, since these characters never belong
// there. Used only to evaluate channel-only GuildRoleRules (e.g. level-range
// leveling channels) against — never contributes to role grants, since the
// person isn't a member here for that character. Re-running onboarding
// upserts fresh level/class/actualGuildName.
model GuildExternalCharacter {
  id              String   @id @default(cuid())
  guildId         String
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId   String
  discordUserTag  String
  name            String
  level           Int
  class           String?
  // null = not currently in any guild; otherwise the other guild's name.
  actualGuildName String?
  claimedAt       DateTime @default(now())

  @@unique([guildId, discordUserId, name])
}

// Last time each Discord member was seen sending a message in the guild's
// server, plus their join time — feeds the inactivity filter above
// (Guild.inactivityFilterEnabled etc). Updated at most every 12h per
// message (see ACTIVITY_UPDATE_THROTTLE_MS in the bot) to avoid writing on
// every single message. markedInactiveAt is set when the daily filter adds
// the inactive role on top of someone's existing roles (nothing removed,
// so nothing to restore) — /reactivate just removes that one role again.
model GuildMemberActivity {
  id               String    @id @default(cuid())
  guildId          String
  guild            Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId    String
  discordUserTag   String
  lastActiveAt     DateTime
  joinedAt         DateTime
  markedInactiveAt DateTime?

  @@unique([guildId, discordUserId])
}

// A Discord-onboarding role grant rule: fires — granting every one of its
// grantedRoles — only when every one of its conditions is satisfied.
// Admin-built on the site — deliberately not fixed "rank role" / "level
// role" special cases, so any combination of rank/level/class conditions
// can gate any set of roles (e.g. rank "Trial Raider" granting both a
// generic "Guildie" role and a "Trial Raider" role from the same rule).
model GuildRoleRule {
  id              String  @id @default(cuid())
  guildId         String
  guild           Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  label           String?
  grantedRoles    GuildRoleRuleGrantedRole[]
  grantedChannels GuildRoleRuleGrantedChannel[]
  conditions      GuildRoleRuleCondition[]
}

// One Discord role a GuildRoleRule grants when it fires. A rule can grant
// several — kept as its own table rather than a scalar list since SQLite/
// Prisma has no native array column, same reasoning as conditions below.
model GuildRoleRuleGrantedRole {
  id            String        @id @default(cuid())
  ruleId        String
  rule          GuildRoleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  discordRoleId String
}

// Direct per-member channel access a GuildRoleRule grants when it fires —
// an alternative/addition to grantedRoles for when access should be scoped
// to one specific channel rather than going through a role. Applied as a
// per-member permission overwrite (ViewChannel, plus Connect for voice),
// not a role, so it works even for a channel an admin doesn't want tied to
// any existing role.
model GuildRoleRuleGrantedChannel {
  id               String        @id @default(cuid())
  ruleId           String
  rule             GuildRoleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  discordChannelId String
  channelType      String // "text" | "voice" — determines which permissions get granted
}

// One AND'd condition within a GuildRoleRule. Satisfied if ANY of the
// person's matched characters (main or alt, from the bot's onboarding DM)
// meets it — different conditions in the same rule can each be satisfied
// by a different character (e.g. rank condition met by the main, level
// condition met by an alt).
model GuildRoleRuleCondition {
  id        String        @id @default(cuid())
  ruleId    String
  rule      GuildRoleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  field     String  // "rank" | "level" | "class"
  operator  String  // "equals" (rank/class) | "between" (level)
  textValue String? // used when operator == "equals"
  minNumber Int?    // used when operator == "between"
  maxNumber Int?    // used when operator == "between"
}

// One node in a guild's admin-built onboarding question graph (built via a
// flowchart canvas on the site — see GuildOnboardingEdge for the branching
// between nodes). canvasX/canvasY persist the builder's layout across
// sessions; they're display-only, not used by the bot when walking the
// graph. type drives which Discord component the bot uses to ask it.
model GuildOnboardingQuestion {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  prompt    String
  type      String   // "single_select" | "multi_select" | "free_text"
  // Optional questions offer a "Skip" choice in Discord and, if skipped,
  // just aren't answered — no GuildOnboardingAnswer row is written for
  // that person/question, and the flow moves on rather than blocking.
  required  Boolean  @default(true)
  canvasX   Float    @default(0)
  canvasY   Float    @default(0)
  createdAt DateTime @default(now())

  options  GuildOnboardingQuestionOption[]
  outEdges GuildOnboardingEdge[]           @relation("EdgeFrom")
  inEdges  GuildOnboardingEdge[]           @relation("EdgeTo")
  answers  GuildOnboardingAnswer[]
}

// One selectable option for a single_select/multi_select question — unused
// for free_text. sortOrder is explicit since child rows (same reasoning as
// GuildRoleRuleGrantedRole) have no inherent order of their own.
model GuildOnboardingQuestionOption {
  id         String                  @id @default(cuid())
  questionId String
  question   GuildOnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int

  answerSelections     GuildOnboardingAnswerOption[]
  conditionOptionLinks GuildOnboardingEdgeConditionOption[]
}

// One connection drawn on the canvas. fromQuestionId null means it
// originates from the synthetic "Start" node (not a DB row, always the
// graph's entry point). Each edge still has only one condition TYPE, but
// answer_equals/class_equals can each match a whole OR-set of values (see
// GuildOnboardingEdgeConditionOption/Class below) — "if class is Warrior OR
// Rogue" is one edge with two conditionClasses rows, not two separate
// edges. Composing across DIFFERENT fields (e.g. class AND level) still
// isn't supported — draw two edges in series for that, or two edges into
// the same target for an OR across types, which the graph shape already
// gives for free.
model GuildOnboardingEdge {
  id                String                   @id @default(cuid())
  guildId           String
  guild             Guild                    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  fromQuestionId    String?
  fromQuestion      GuildOnboardingQuestion? @relation("EdgeFrom", fields: [fromQuestionId], references: [id], onDelete: Cascade)
  toQuestionId      String
  toQuestion        GuildOnboardingQuestion  @relation("EdgeTo", fields: [toQuestionId], references: [id], onDelete: Cascade)
  conditionType     String                   // "always" | "answer_equals" | "class_equals" | "level_between"
  // Used when conditionType == "level_between" — same min/max-range idea
  // as GuildRoleRuleCondition's "between" operator. Level comes from the
  // person's matched GuildRosterMember row (see onboardingQuestions.ts in
  // the bot), same as class — meaningless for rosterSource "onboarding"
  // guilds, where level is always fixed to 1, so this condition just never
  // fires there.
  conditionMinLevel Int?
  conditionMaxLevel Int?

  conditionOptions GuildOnboardingEdgeConditionOption[]
  conditionClasses GuildOnboardingEdgeConditionClass[]
}

// One option (of possibly several, OR'd) that satisfies an
// conditionType == "answer_equals" edge — fires if fromQuestion's given
// answer includes ANY of these. Only valid when fromQuestionId is set
// (Start has no prior answer to compare).
model GuildOnboardingEdgeConditionOption {
  id       String                        @id @default(cuid())
  edgeId   String
  edge     GuildOnboardingEdge           @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  optionId String
  option   GuildOnboardingQuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

// One WoW class token (of possibly several, OR'd) that satisfies a
// conditionType == "class_equals" edge — see WOW_CLASS_CHOICES in the bot /
// CLASS_COLORS on the site for the 9 valid tokens. Valid from Start (picks
// the first question by class) or from a question (gates a follow-up by
// class regardless of prior answers).
model GuildOnboardingEdgeConditionClass {
  id     String              @id @default(cuid())
  edgeId String
  edge   GuildOnboardingEdge @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  class  String
}

// One person's answer to one custom onboarding question, in one guild.
// Keyed by discordUserId rather than a roster row — a PUG or not-yet-
// claimed member can answer before any GuildRosterMember row exists for
// them, same reasoning as GuildMemberNickname/GuildPugMember below.
// free_text answers use textValue; single/multi_select answers use
// selectedOptions instead (one row for single_select, one or more for
// multi_select) and leave textValue null.
model GuildOnboardingAnswer {
  id              String                        @id @default(cuid())
  guildId         String
  guild           Guild                         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId   String
  discordUserTag  String
  questionId      String
  question        GuildOnboardingQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textValue       String?
  selectedOptions GuildOnboardingAnswerOption[]
  updatedAt       DateTime                      @updatedAt

  @@unique([guildId, discordUserId, questionId])
}

// One selected option within a select-type GuildOnboardingAnswer.
model GuildOnboardingAnswerOption {
  id       String                        @id @default(cuid())
  answerId String
  answer   GuildOnboardingAnswer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  optionId String
  option   GuildOnboardingQuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([answerId, optionId])
}

// A custom event signup — e.g. a 5-man dungeon group — created either via
// the bot's /event create command or the site's event form. Posted/kept in
// sync as a single Discord message the bot edits in place (discordMessageId
// is null until the bot's poll picks it up and posts it, which is how a
// web-created event reaches Discord — same "web writes the DB + a flag, the
// bot's periodic tick notices and acts" pattern as forceSyncRequestedAt).
// Signing up, voting, leaving, and cancelling all happen through the
// Discord message's own components — the site only creates/lists/cancels,
// it doesn't mirror the interactive parts.
// A channel-specific default role composition (e.g. the "Wailing Caverns"
// channel always wants Tank:1, Healer:1, DPS:3) — pre-fills the "Roles"
// field when /guildthing event is run in that channel, instead of retyping
// the same composition every time. Stored in the same "Name:Count:Emoji,
// ..." format the create modal's Roles field already parses (see
// parseRoleSlots in apps/bot/src/events.ts), so it can be dropped straight
// into that field's default value with no extra parsing/formatting.
// Also doubles as per-channel event-button config — buttonEnabled is
// independent of whether a roles preset is set (a channel can have a
// standing "Create new event" button with no preset, or a preset with no
// button), same "each part optional, use what you need" spirit as the rest
// of this feature.
model EventChannelPreset {
  id               String  @id @default(cuid())
  guildId          String
  guild            Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordChannelId String
  roles            String?

  // Whether the bot keeps a standing "Create new event" button message at
  // the bottom of this channel — same idea as Guild.onboardingChannelId's
  // button, for people who'd rather click than type /guildthing event.
  buttonEnabled   Boolean @default(false)
  buttonMessageId String?
  // Admin-customizable text shown above the button — null means use the
  // bot's built-in default (see EVENT_BUTTON_MESSAGE_TEXT in events.ts).
  buttonMessageText String?

  // "live" (default) — the button reposts to the bottom of the channel on
  // every new message (debounced, see scheduleEventButtonRepostOnMessage
  // in events.ts), so it never gets buried but can spam an active channel.
  // "daily" — the button is left wherever it drifts to as people chat, and
  // only gets forced back to the bottom once every 24h (see
  // repostDailyEventButtons in events.ts).
  buttonRepostMode String @default("live")
  // When the button message was last (re)posted, in either mode — the
  // clock "daily" mode checks against. Set on every repost, including the
  // very first post, so a fresh preset doesn't immediately re-fire.
  lastButtonRepostAt DateTime?

  @@unique([guildId, discordChannelId])
}

model Event {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  title    String
  imageUrl String?
  // "yyyy-mm-dd" — shown as "Date: {date}" on the embed. Defaults to
  // today's date in both the bot modal and the web form (not enforced
  // here), so it's rarely actually null in practice.
  date String?
  // Free-text blurb shown under the title on the embed. Not on the bot's
  // create modal (already at Discord's 5-text-input cap) — set via the web
  // form at creation, or the bot's Edit modal afterward.
  description String?
  // Whether the "+ Add time option" button shows at all — off lets a
  // creator post one or more FIXED times (e.g. "just tonight at 20:00, no
  // discussion") without randoms tacking on more alternatives to vote
  // on. Toggled via a button on the posted event (no room for a checkbox
  // in the create modal — Discord modals don't support that component
  // type at all, not just a field-count limit). Voting on whatever options
  // already exist still works regardless of this.
  allowTimeSuggestions Boolean @default(true)

  // Repeat this event every N days, indefinitely — set at creation only
  // (see GuildEventsForm). When runEventExpiry auto-cancels this occurrence
  // (24h after its date), it clones a fresh Event dated N days later with
  // the same recurrenceIntervalDays, so the series continues on its own.
  // Manually cancelling an occurrence stops the series (no next one is
  // spawned) rather than continuing it — cancelling is treated as "stop
  // this", not just "skip this one".
  recurrenceIntervalDays Int?

  createdByDiscordUserId String
  createdByDiscordTag    String

  discordChannelId String
  // Each event gets its own thread (named after the title) so signing up
  // doesn't clutter the parent channel — null until the bot's poll (or
  // immediate post, for bot-created events) creates it. Deleted outright
  // when the event is cancelled, for a clean "it's just gone" cancel.
  discordThreadId String?
  // The embed message posted inside that thread — null until the thread
  // exists.
  discordMessageId String?

  // "open" | "locked" | "cancelled"
  status String @default("open")
  // Set once locked (auto after 30min-since-createdAt or every role slot
  // full, whichever first — see runEventAutoLock) to whichever
  // EventTimeOption had the most votes.
  lockedTimeOptionId String?

  // Set by web-side create/cancel so the bot's poll tick knows to
  // (re)render the Discord message without waiting on any other signal —
  // cleared once the bot's synced it.
  pendingWebUpdate Boolean @default(false)

  createdAt DateTime @default(now())

  timeOptions EventTimeOption[]
  roleSlots   EventRoleSlot[]
  signups     EventSignup[]
  votes       EventTimeVote[]

  @@index([guildId])
}

// One proposed time slot people can vote for. Free-text label (e.g.
// "19:00–21:00") rather than structured start/end — nothing here parses or
// compares times, it's purely a votable option.
model EventTimeOption {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label   String
  votes   EventTimeVote[]
}

// One person's vote in one event — a person has exactly one vote per event
// (moving it between options is "changing your vote", not adding another),
// hence the unique on (eventId, discordUserId) rather than per-option.
model EventTimeVote {
  id            String          @id @default(cuid())
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeOptionId  String
  timeOption    EventTimeOption @relation(fields: [timeOptionId], references: [id], onDelete: Cascade)
  discordUserId String
  votedAt       DateTime        @default(now())

  @@unique([eventId, discordUserId])
}

// A role bucket needed for the event (e.g. "Tank" x1, "DPS" x3) — free-text
// name rather than a fixed tank/healer/dps enum, so this isn't locked to
// WoW's trinity if it's ever used for something else.
model EventRoleSlot {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleName String
  capacity Int
  // Unicode emoji ("🛡️") or a Discord custom emoji in its raw <:name:id>/
  // <a:name:id> form — whoever creates the event picks it, shown next to
  // the role name on the embed. Null falls back to no icon at all.
  emoji    String?
  signups  EventSignup[]
}

// One person signed up for one role slot in one event — the unique on
// (eventId, discordUserId) is what makes "sign up for a different role"
// a move rather than a second entry, same idea as EventTimeVote.
// characterName/class are auto-filled from the account's claimed
// GuildRosterMember when one exists, left null otherwise — nothing here
// re-asks for data the roster already has.
model EventSignup {
  id             String         @id @default(cuid())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Null for an "absence" entry (see status below) — someone marking
  // themselves absent isn't claiming any role, so there's nothing to point
  // this at.
  roleSlotId     String?
  roleSlot       EventRoleSlot? @relation(fields: [roleSlotId], references: [id], onDelete: Cascade)
  discordUserId  String
  discordUserTag String
  characterName  String?
  class          String?
  // "confirmed" | "tentative" | "absence" — confirmed/tentative toggle via
  // "Toggle tentative" and require a role slot; a tentative signup doesn't
  // count toward the slot's capacity (shown with a marker instead), so
  // someone unsure doesn't block someone who can commit. "absence" comes
  // from the "Absence" button instead, has no role slot, and is shown in
  // its own list on the embed rather than under any role.
  status         String         @default("confirmed")
  signedUpAt     DateTime       @default(now())

  @@unique([eventId, discordUserId])
}

model GuildRequiredRole {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String

  @@unique([guildId, discordRoleId])
}

// Discord role IDs that grant admin rights within the app for this guild
// (editing guild settings, viewing the raw recipe catalog) — separate from
// requiredRoles, which only grants ordinary view/import access.
model GuildAdminRole {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String

  @@unique([guildId, discordRoleId])
}

// A mutually-exclusive role tier (e.g. Core Raider > Trial Raider >
// Guildie) — a person can independently qualify for more than one of
// these via different alts (each GuildRoleRule only checks "does ANY of
// their characters match", unaware of what other rules fired), which
// without this would hand them every tier's role at once. See
// evaluateRules in roleLogic.ts: when 2+ roles from this list would be
// granted to the same person, only the lowest `priority` (0 = highest)
// survives. Purely opt-in — a role not in this list is never touched by
// it, so ordinary additive roles (class roles, PUG role, etc) are
// unaffected.
model GuildRolePriority {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordRoleId String
  priority      Int

  @@unique([guildId, discordRoleId])
}

model GuildCharacter {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // Null means "unclaimed" — a peer-sourced row created from someone else's
  // P2P recipe cache (see OurRecipes' P2PSync.lua), not a self-import. Gets
  // claimed (set, and never unset again) the first time the real player
  // self-imports this exact name+realm — see importCharacter's peers loop
  // vs. its self-import branch. Character identity is guild+name+realm, not
  // guild+user+name+realm: a WoW character name is already unique per
  // realm, so two different users can never legitimately claim the same row.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  realm       String
  // WoW class token (e.g. "WARRIOR") — sent by the addon's export, null for
  // characters added through the manual entry form (createCharacter), which
  // has no way to know it.
  class       String?
  importedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  professions Profession[]

  @@unique([guildId, name, realm])
}

model Profession {
  id          String   @id @default(cuid())
  characterId String
  character   GuildCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  recipes     Recipe[]

  @@unique([characterId, name])
}

model Recipe {
  id           String   @id @default(cuid())
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  name         String
  itemId       Int?
  spellId      Int?

  @@index([professionId])
  @@index([name])
}

// Persists resolved Discord guild-member roles across server restarts.
// Discord's /users/@me/guilds/{id}/member endpoint rate-limits hard (order
// of minutes), and an in-memory-only cache gets wiped by every dev-server
// reload or prod deploy, which was enough on its own to trigger repeated
// 429s. roles is JSON-encoded (null when the user isn't a guild member).
model DiscordMemberRoleCache {
  id             String   @id @default(cuid())
  discordGuildId String
  userId         String
  roles          String?
  fetchedAt      DateTime @default(now())

  @@unique([discordGuildId, userId])
}

// Caches a Discord server's own name/icon (from /users/@me/guilds, keyed by
// whichever user's token we last used). Server-owned data, not per-viewer —
// safe to reuse for any user, so this is keyed by discordGuildId alone.
model DiscordGuildInfoCache {
  discordGuildId String   @id
  name           String
  icon           String?
  fetchedAt      DateTime @default(now())
}

// Short-TTL whole-guild snapshot of "member -> role names", fed by the
// bot-token getGuildMembers/getGuildRoles (apps/web/src/server/discord.ts)
// — NOT the same thing as DiscordMemberRoleCache above, which only ever
// covers users who've personally logged into the website (for site access
// control) and is keyed per-viewer's own OAuth token. This one exists for
// the addon-facing /api/v1/discord-roles endpoint, which needs role data
// for every roster member regardless of whether they've ever visited the
// site. data is JSON: { [discordUserId]: { tag, roleNames: string[] } }.
// 5 minutes is plenty fresh for data that only ever reaches the WoW client
// at its next login/reload anyway.
model DiscordRolesSnapshotCache {
  discordGuildId String   @id
  data           String
  fetchedAt      DateTime @default(now())
}
