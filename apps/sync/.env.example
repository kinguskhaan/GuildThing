# Copy this file to .env and fill in your own values.

# Your GuildThing instance's URL.
GUILDTHING_API_URL="http://localhost:3000"

# Get one from your guild's admin > API keys page on the site.
GUILDTHING_API_KEY=""

# Only needed on Linux/Steam Proton, where the install path can't be
# guessed (it includes a per-game compatdata folder id). Point this at the
# folder that contains "Account" — e.g.:
# WOW_WTF_DIR="/home/you/.local/share/Steam/steamapps/compatdata/2150076104/pfx/drive_c/Program Files (x86)/World of Warcraft/_anniversary_/WTF"
WOW_WTF_DIR=""
