# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
packages/db/prisma/db.sqlite
packages/db/prisma/db.sqlite-journal
db.sqlite

# next.js
.next/
/out/
next-env.d.ts

# turborepo
.turbo

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# do not commit sync targets/API keys, except sync.config.example.json
apps/sync/sync.config.json
apps/sync/sync.log
# local "already relayed this request-sync flag" bookkeeping — see syncState.ts
apps/sync/sync.state.json

# apps/sync overwrites this on every run (Discord roles + audit log data
# for whichever guild you're testing against) — real end users get it the
# same way, written into their own local WoW install, never through git.
# On this dev machine specifically, apps/addon/GuildThing/ happens to be
# symlinked into a live WTF-adjacent install for testing, so without this
# ignore, every test run would dirty the tracked file. package-addon.ts
# creates a stub here if missing, so a fresh checkout still ships one.
apps/addon/GuildThing/SyncData.lua

# typescript
*.tsbuildinfo

# idea files
.idea

# Claude Code per-project state (session memory, worktree locks) — never
# meant for version control, and can appear in any directory Claude Code
# has run in, not just the repo root (e.g. addon/GuildThing/.claude/).
.claude/
**/.claude/
# desktop app build output
apps/desktop/dist
apps/desktop/src-tauri/target
apps/desktop/src-tauri/gen
