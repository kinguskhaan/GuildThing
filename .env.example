# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in
# "apps/web/src/env.js" should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Public URL the app is served from — used to derive OAuth callback URLs
BETTER_AUTH_URL="http://localhost:3000"

# Better Auth Discord OAuth (web login)
BETTER_AUTH_DISCORD_CLIENT_ID=""
BETTER_AUTH_DISCORD_CLIENT_SECRET=""

# Discord bot (apps/bot) — the bot's own token, from the Discord Developer
# Portal (Bot tab), separate from the OAuth client id/secret above
DISCORD_BOT_TOKEN=""

# Only this account (matched by email) is allowed to create new guilds
GUILD_CREATOR_EMAIL=""

# Battle.net Game Data API (apps/bot/src/battlenetApi.ts) — optional, only
# needed if a guild has armory lookup config set (see the "Character lookup"
# section on the Discord onboarding roles admin page). Client-credentials
# OAuth app created at develop.battle.net — no redirect URI is actually used.
BNET_CLIENT_ID=""
BNET_CLIENT_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
#
# Must be an ABSOLUTE path, not relative — the Prisma CLI resolves relative
# sqlite file: URLs relative to packages/db/prisma/schema.prisma, but the
# generated Client resolves them relative to process.cwd() at runtime
# (apps/web when running `pnpm dev`) — those two don't agree in a monorepo,
# so a relative path breaks one or the other. Point this at
# packages/db/prisma/db.sqlite in your own checkout, e.g.:
DATABASE_URL="file:/absolute/path/to/guildthing/packages/db/prisma/db.sqlite"
